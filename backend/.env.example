# ─── Base de données ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./ihec_connect.db
# Pour PostgreSQL : DATABASE_URL=postgresql://user:password@localhost/ihec_connect

# ─── JWT ─────────────────────────────────────────────────────────────────────
SECRET_KEY=6Ld8bcYsAAAAAJbbOXsML49G_FJaVgw-9MGFMVYR
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── CORS ────────────────────────────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:5173","https://votre-domaine.com"]

# ─── SMTP — Équivalent PHPMailer ─────────────────────────────────────────────
# Fonctionne avec Gmail (App Password), OVH, Infomaniak, SendGrid, Mailgun...
# Exemple Gmail :
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-app-password-gmail   # Générer dans Compte Google > Sécurité > Mots de passe d'application
SMTP_FROM_NAME=IHEC Connect
SMTP_FROM_EMAIL=noreply@ihec.ucar.tn
SMTP_TLS=true
SMTP_SSL=false

# Exemple IHEC SMTP universitaire :
# SMTP_HOST=mail.ucar.tn
# SMTP_PORT=587
# SMTP_USER=noreply@ihec.ucar.tn
# SMTP_PASSWORD=mot-de-passe-smtp

# ─── Google reCAPTCHA v2 ─────────────────────────────────────────────────────
# 1. Aller sur https://www.google.com/recaptcha/admin/create
# 2. Choisir "reCAPTCHA v2" → "Je ne suis pas un robot"
# 3. Ajouter vos domaines (localhost pour le développement)
# 4. Copier les deux clés ci-dessous
RECAPTCHA_SECRET_KEY=6Ld8bcYsAAAAAJbbOXsML49G_FJaVgw-9MGFMVYR  # Ne jamais exposer côté client !
RECAPTCHA_SITE_KEY=6Ld8bcYsAAAAANqy-GBd-JXcB-wjlBkKiiqLPf2F     # Utilisée aussi côté frontend

# ─── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRE_MINUTES=30
